# platform = multi_platform_all
# reboot = false
# strategy = enable
# complexity = low
# disruption = low

{{{ bash_instantiate_variables("var_firewall_accept_other_utility") }}}

{{#- Another utility is in use as in the OVAL check: its package is
installed and a .wants directory of /etc/systemd/system links one of its
services. #}}
firewall_other_utility_in_use=false
{{%- for u in OTHERS %}}
if {{{ bash_pkg_conditional(u.package) | trim }}} && { {{% for s in u.services %}}compgen -G '/etc/systemd/system/*.wants/{{{ s }}}.service' > /dev/null{{% if not loop.last %}} || {{% endif %}}{{% endfor %}}; }; then
    firewall_other_utility_in_use=true
fi
{{%- endfor %}}

if [ "$var_firewall_accept_other_utility" != "true" ] || [ "$firewall_other_utility_in_use" != "true" ]; then
    {{{ bash_package_install(package=PACKAGE) }}}
fi
