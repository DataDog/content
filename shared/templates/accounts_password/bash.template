# platform = multi_platform_all
# reboot = false
# strategy = restrict
# complexity = low
# disruption = low

{{{ bash_instantiate_variables("var_password_pam_" ~ VARIABLE) }}}

{{% if 'ol' in families or 'rhel' in product or product == 'almalinux9' or 'ubuntu' in product %}}
if grep -sq {{{ VARIABLE }}} /etc/security/pwquality.conf.d/*.conf ; then
    sed -i "/{{{ VARIABLE }}}/d" /etc/security/pwquality.conf.d/*.conf
fi
{{% endif %}}

{{% if "ol" in families or product == "rhel7" %}}
{{{ bash_remove_pam_module_option_configuration('/etc/pam.d/system-auth',
                                  'password',
                                  '',
                                  'pam_pwquality.so',
                                  VARIABLE)
}}}
{{{ bash_remove_pam_module_option_configuration('/etc/pam.d/password-auth',
                                  'password',
                                  '',
                                  'pam_pwquality.so',
                                  VARIABLE)
}}}
{{% endif %}}

{{% if product == "ubuntu2404" %}}
{{{ bash_pam_pwquality_enable() }}}
{{% endif %}}

{{% if product in ['sle15', 'sle16'] %}}
{{{ bash_ensure_pam_module_configuration('/etc/pam.d/common-password', 'password', 'requisite', 'pam_pwquality.so', '', '', 'BOF') }}}
{{% endif %}}

{{% if product == 'sle16' %}}
{{{ bash_copy_distro_defaults('/usr/lib/security/pwquality.conf', pwquality_path) }}}
{{% endif %}}

# pwquality reads indented settings as well, and bash_replace_or_append
# replaces those that start a line, so remove the indented ones.
if [ -f "{{{ pwquality_path }}}" ]; then
    LC_ALL=C sed -i --follow-symlinks "/^[[:space:]]\+{{{ VARIABLE }}}\>/Id" "{{{ pwquality_path }}}"
fi
{{{ bash_replace_or_append(pwquality_path, '^' ~ VARIABLE , '$var_password_pam_' ~ VARIABLE , '%s = %s', cce_identifiers=cce_identifiers) }}}
