{{#-
The guidance for a firewall utility applies where that utility is in use
or no other one is, as the CIS-CAT checks of the Debian and Ubuntu
benchmarks pass over a section (no_ufw.sh, deb_no_nftables.sh,
deb_no_iptables.sh). A utility is in use:
- ufw: package installed, ENABLED=yes in /etc/ufw/ufw.conf (the firewall
  that ufw status reports after boot) and ufw.service enabled.
- nftables: package installed and nftables.service enabled.
- iptables: package iptables-persistent installed.
A service is enabled when a .wants directory of /etc/systemd/system links
it, as systemctl enable leaves it, which the check reads without systemd
(agentless scans of snapshots, containers).
The ufw guidance applies wherever ufw is installed, as no_ufw.sh passes
over it only on a host without ufw.
-#}}
{{%- macro in_use(u) %}}
{{%- if u == "ufw" %}}
        <criterion test_ref="test_{{{ _RULE_ID }}}_ufw_installed"
          comment="package ufw is installed"/>
        <criterion test_ref="test_{{{ _RULE_ID }}}_ufw_conf_enabled"
          comment="ufw is enabled in /etc/ufw/ufw.conf"/>
        <criterion test_ref="test_{{{ _RULE_ID }}}_ufw_service_enabled"
          comment="ufw.service is enabled"/>
{{%- elif u == "nftables" %}}
        <criterion test_ref="test_{{{ _RULE_ID }}}_nftables_installed"
          comment="package nftables is installed"/>
        <criterion test_ref="test_{{{ _RULE_ID }}}_nftables_service_enabled"
          comment="nftables.service is enabled"/>
{{%- else %}}
        <criterion test_ref="test_{{{ _RULE_ID }}}_iptables-persistent_installed"
          comment="package iptables-persistent is installed"/>
{{%- endif %}}
{{%- endmacro %}}
{{%- macro service_enabled_test(s) %}}
  <unix:file_test id="test_{{{ _RULE_ID }}}_{{{ s }}}_service_enabled" version="1"
    check="all" check_existence="at_least_one_exists"
    comment="{{{ s }}}.service is enabled">
    <unix:object object_ref="obj_{{{ _RULE_ID }}}_{{{ s }}}_service_enabled"/>
  </unix:file_test>
  <unix:file_object id="obj_{{{ _RULE_ID }}}_{{{ s }}}_service_enabled" version="1"
    comment="the link of {{{ s }}}.service in a .wants directory of /etc/systemd/system">
    <unix:path operation="pattern match">^/etc/systemd/system/[^/]+\.wants$</unix:path>
    <unix:filename>{{{ s }}}.service</unix:filename>
  </unix:file_object>
{{%- endmacro %}}
<def-group>
  <definition class="inventory" id="{{{ _RULE_ID }}}" version="1">
    {{{ oval_metadata("The CIS guidance for the " + ARG + " firewall utility applies: " + ARG + " is in use, or no other firewall utility is in use.", title="The CIS guidance for the " + ARG + " firewall utility applies", affected_platforms=["multi_platform_all"]) }}}
    <criteria operator="OR" comment="{{{ ARG }}} is in use, or no other firewall utility is in use">
{{%- if ARG == "ufw" %}}
      <criterion test_ref="test_{{{ _RULE_ID }}}_ufw_installed"
        comment="package ufw is installed"/>
{{%- else %}}
      <criteria operator="AND" comment="{{{ ARG }}} is in use">
{{{- in_use(ARG) }}}
      </criteria>
{{%- endif %}}
      <criteria operator="AND" comment="no other firewall utility is in use">
{{%- for u in OTHERS %}}
        <criteria operator="AND" negate="true" comment="{{{ u }}} is not in use">
  {{{- in_use(u) | indent(2) }}}
        </criteria>
{{%- endfor %}}
      </criteria>
    </criteria>
  </definition>
  {{{ oval_test_package_installed(package="ufw", test_id="test_" + _RULE_ID + "_ufw_installed") }}}
  {{{ oval_test_package_installed(package="nftables", test_id="test_" + _RULE_ID + "_nftables_installed") }}}
  {{{ oval_test_package_installed(package="iptables-persistent", test_id="test_" + _RULE_ID + "_iptables-persistent_installed") }}}
{{%- if ARG != "ufw" %}}
  <ind:textfilecontent54_test id="test_{{{ _RULE_ID }}}_ufw_conf_enabled" version="1"
    check="all" check_existence="at_least_one_exists"
    comment="ufw is enabled in /etc/ufw/ufw.conf">
    <ind:object object_ref="obj_{{{ _RULE_ID }}}_ufw_conf_enabled"/>
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_{{{ _RULE_ID }}}_ufw_conf_enabled" version="1">
    <ind:filepath>/etc/ufw/ufw.conf</ind:filepath>
    <ind:pattern operation="pattern match">^[ \t]*ENABLED="?(yes|YES)"?[ \t]*$</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>
  {{{- service_enabled_test("ufw") }}}
{{%- endif %}}
  {{{- service_enabled_test("nftables") }}}
</def-group>
