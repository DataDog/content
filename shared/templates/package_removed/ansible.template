# platform = multi_platform_all
# reboot = false
# strategy = disable
# complexity = low
# disruption = low

{{% for package in PACKAGES %}}
- name: "{{{ rule_title }}}: Ensure {{{ package }}} is removed"
{{%- if pkg_manager == "apt_get" %}}
  ansible.builtin.apt:
    name: "{{{ package }}}"
    state: absent
    purge: true
{{%- else %}}
  ansible.builtin.package:
    name: "{{{ package }}}"
    state: absent
{{%- endif %}}
{{% endfor %}}
