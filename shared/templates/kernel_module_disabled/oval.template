<def-group>
  <definition class="compliance"
  id="{{{ _RULE_ID }}}" version="1">
    {{{ oval_metadata("The kernel module " + KERNMODULE + " should be disabled.", rule_title=rule_title) }}}
    <criteria operator="OR">
      {{% if product in ["al2023", "fedora", "rhcos4"] or 'ol' in families or 'rhel' in product or 'almalinux' in product or 'sle' in product or 'slmicro' in product or 'ubuntu' in product %}}
      <criteria operator="AND">
        <criterion test_ref="test_kernmod_{{{ KERNMODULE }}}_blacklisted"
        comment="kernel module {{{ KERNMODULE }}} blacklisted in modprobe.d" />
        <criterion test_ref="test_kernmod_{{{ KERNMODULE }}}_disabled"
        comment="kernel module {{{ KERNMODULE }}} disabled in modprobe.d" />
      </criteria>
      {{% else %}}
      <criterion test_ref="test_kernmod_{{{ KERNMODULE }}}_disabled"
      comment="kernel module {{{ KERNMODULE }}} disabled in modprobe.d" />
      {{% endif %}}
{{% if "ubuntu" not in product and "rhel" not in product and "almalinux" not in product and "ol" not in families and product not in ["al2023", "fedora"] %}}
      <criterion test_ref="test_kernmod_{{{ KERNMODULE }}}_modprobeconf" comment="kernel module {{{ KERNMODULE }}} disabled in /etc/modprobe.conf" />
{{% endif %}}
      <criteria operator="AND" comment="kernel module {{{ KERNMODULE }}} absent, where an absent module counts as disabled">
        <criterion test_ref="test_kernmod_{{{ KERNMODULE }}}_absent_disabled"
        comment="an absent kernel module counts as disabled" />
        <criterion test_ref="test_kernmod_{{{ KERNMODULE }}}_absent"
        comment="kernel module {{{ KERNMODULE }}} absent from every installed kernel" />
      </criteria>
    </criteria>
  </definition>

  <ind:variable_test id="test_kernmod_{{{ KERNMODULE }}}_absent_disabled" version="1" check="all"
  check_existence="all_exist" comment="an absent kernel module counts as disabled">
    <ind:object object_ref="obj_kernmod_{{{ KERNMODULE }}}_absent_disabled" />
    <ind:state state_ref="state_kernmod_{{{ KERNMODULE }}}_absent_disabled" />
  </ind:variable_test>

  <ind:variable_object id="obj_kernmod_{{{ KERNMODULE }}}_absent_disabled" version="1">
    <ind:var_ref>var_kernel_module_absent_disabled</ind:var_ref>
  </ind:variable_object>

  <ind:variable_state id="state_kernmod_{{{ KERNMODULE }}}_absent_disabled" version="1">
    <ind:value datatype="boolean">true</ind:value>
  </ind:variable_state>

  <external_variable id="var_kernel_module_absent_disabled" datatype="boolean" version="1"
  comment="an absent kernel module counts as disabled" />

  <unix:file_test id="test_kernmod_{{{ KERNMODULE }}}_absent" version="1" check="all"
  check_existence="none_exist" comment="kernel module {{{ KERNMODULE }}} absent from every installed kernel">
    <unix:object object_ref="obj_kernmod_{{{ KERNMODULE }}}_absent" />
  </unix:file_test>

  <unix:file_object id="obj_kernmod_{{{ KERNMODULE }}}_absent" version="1"
  comment="files of kernel module {{{ KERNMODULE }}} in the installed kernels">
    <unix:behaviors recurse="directories" recurse_direction="down" recurse_file_system="local" />
    <unix:path operation="pattern match">^/lib/modules/[^/]+/kernel$</unix:path>
    <unix:filename operation="pattern match">^{{{ KERNMODULE }}}\.ko(\.(gz|xz|zst))?$</unix:filename>
  </unix:file_object>

  <ind:textfilecontent54_test id="test_kernmod_{{{ KERNMODULE }}}_disabled" version="1" check="all"
  comment="kernel module {{{ KERNMODULE }}} disabled">
    <ind:object object_ref="obj_kernmod_{{{ KERNMODULE }}}_disabled" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_object id="obj_kernmod_{{{ KERNMODULE }}}_disabled"
  version="1" comment="kernel module {{{ KERNMODULE }}} disabled">
    <ind:path var_ref="var_kernel_module_{{{ KERNMODULE }}}_paths" var_check="at least one" />
    <ind:filename operation="pattern match">^.*\.conf$</ind:filename>
    <ind:pattern operation="pattern match">^\s*install\s+{{{ KERNMODULE }}}\s+(/bin/false|/bin/true)$</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>

  <constant_variable datatype="string" comment="Other paths where kernel modules can be configured"
  id="var_kernel_module_{{{ KERNMODULE }}}_paths" version="1">
    <value>/etc/modprobe.d</value>
    <value>/etc/modules-load.d</value>
    <value>/run/modprobe.d</value>
    <value>/run/modules-load.d</value>
    <value>/usr/lib/modprobe.d</value>
    <value>/usr/lib/modules-load.d</value>
  </constant_variable>

{{% if product in ["al2023", "fedora", "rhcos4"] or 'ol' in families or 'rhel' in product or 'almalinux' in product or 'sle' in product or 'slmicro' in product or 'ubuntu' in product %}}
  <ind:textfilecontent54_test id="test_kernmod_{{{ KERNMODULE }}}_blacklisted" version="1" check="all"
  comment="kernel module {{{ KERNMODULE }}} blacklisted">
    <ind:object object_ref="obj_kernmod_{{{ KERNMODULE }}}_blacklisted" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_object id="obj_kernmod_{{{ KERNMODULE }}}_blacklisted"
  version="1" comment="kernel module {{{ KERNMODULE }}} blacklisted">
    <ind:path var_ref="var_kernel_module_{{{ KERNMODULE }}}_paths" var_check="at least one" />
    <ind:filename operation="pattern match">^.*\.conf$</ind:filename>
    <ind:pattern operation="pattern match">^blacklist\s+{{{ KERNMODULE }}}$</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>
{{% endif %}}

{{% if "ubuntu" not in product and "rhel" not in product and "almalinux" not in product and "ol" not in families and product not in ["al2023", "fedora"] %}}
  <ind:textfilecontent54_test id="test_kernmod_{{{ KERNMODULE }}}_modprobeconf" version="1" check="all"
  comment="kernel module {{{ KERNMODULE }}} disabled in /etc/modprobe.conf">
    <ind:object object_ref="obj_kernmod_{{{ KERNMODULE }}}_modprobeconf" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_object id="obj_kernmod_{{{ KERNMODULE }}}_modprobeconf"
  version="1" comment="Check deprecated /etc/modprobe.conf for disablement of {{{ KERNMODULE }}}">
    <ind:filepath>/etc/modprobe.conf</ind:filepath>
    <ind:pattern operation="pattern match">^\s*install\s+{{{ KERNMODULE }}}\s+(/bin/false|/bin/true)$</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>
{{% endif %}}

</def-group>
