{{% set path = "/etc/ssh" %}}
{{% set key_regex = ".*_key$" %}}
{{% set dedicated_ssh_groupname = groups.get("dedicated_ssh_keyowner", {}).get("name") %}}
{{%- if product == "ubuntu2004" %}}
{{#- CIS Ubuntu 20.04 5.1.2 accepts keys of the ssh group with mode 0640. #}}
{{%- set dedicated_ssh_groupname = "ssh" %}}
{{%- endif %}}

<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("The SSH private host keys are owned by root:root with mode 0600 or stricter" ~ ((", or by root:" ~ dedicated_ssh_groupname ~ " with mode 0640 or stricter") if dedicated_ssh_groupname else ""), rule_title=rule_title) }}}
    <criteria>
      <criterion comment="No private host key has an unsafe owner, group or mode"
        test_ref="test_{{{ rule_id }}}" />
    </criteria>
  </definition>

  <unix:file_test check="all" check_existence="none_exist"
    comment="No private host key has an unsafe owner, group or mode"
    id="test_{{{ rule_id }}}" version="1">
    <unix:object object_ref="object_{{{ rule_id }}}_offending" />
  </unix:file_test>

  <unix:file_object comment="Private host keys in {{{ path }}} with an unsafe owner, group or mode"
    id="object_{{{ rule_id }}}_offending" version="1">
    <unix:path>{{{ path }}}</unix:path>
    <unix:filename operation="pattern match">{{{ key_regex }}}</unix:filename>
    <filter action="exclude">state_{{{ rule_id }}}_symlink</filter>
    <filter action="exclude">state_{{{ rule_id }}}_root</filter>
    {{%- if dedicated_ssh_groupname %}}
    <filter action="exclude">state_{{{ rule_id }}}_dedicated</filter>
    {{%- endif %}}
  </unix:file_object>

  <unix:file_state id="state_{{{ rule_id }}}_symlink" version="1">
    <unix:type operation="equals">symbolic link</unix:type>
  </unix:file_state>

  <unix:file_state comment="owned by root:root with mode 0600 or stricter"
    id="state_{{{ rule_id }}}_root" version="1">
    <unix:group_id datatype="int">0</unix:group_id>
    <unix:user_id datatype="int">0</unix:user_id>
    <unix:suid datatype="boolean">false</unix:suid>
    <unix:sgid datatype="boolean">false</unix:sgid>
    <unix:sticky datatype="boolean">false</unix:sticky>
    <unix:uexec datatype="boolean">false</unix:uexec>
    <unix:gread datatype="boolean">false</unix:gread>
    <unix:gwrite datatype="boolean">false</unix:gwrite>
    <unix:gexec datatype="boolean">false</unix:gexec>
    <unix:oread datatype="boolean">false</unix:oread>
    <unix:owrite datatype="boolean">false</unix:owrite>
    <unix:oexec datatype="boolean">false</unix:oexec>
  </unix:file_state>
{{%- if dedicated_ssh_groupname %}}

  <unix:file_state comment="owned by root:{{{ dedicated_ssh_groupname }}} with mode 0640 or stricter"
    id="state_{{{ rule_id }}}_dedicated" version="1">
    <unix:group_id datatype="int" var_ref="var_{{{ rule_id }}}_dedicated_gid" />
    <unix:user_id datatype="int">0</unix:user_id>
    <unix:suid datatype="boolean">false</unix:suid>
    <unix:sgid datatype="boolean">false</unix:sgid>
    <unix:sticky datatype="boolean">false</unix:sticky>
    <unix:uexec datatype="boolean">false</unix:uexec>
    <unix:gwrite datatype="boolean">false</unix:gwrite>
    <unix:gexec datatype="boolean">false</unix:gexec>
    <unix:oread datatype="boolean">false</unix:oread>
    <unix:owrite datatype="boolean">false</unix:owrite>
    <unix:oexec datatype="boolean">false</unix:oexec>
  </unix:file_state>

  <ind:textfilecontent54_object id="object_{{{ rule_id }}}_dedicated_gid" version="1"
    comment="gid of the {{{ dedicated_ssh_groupname }}} group">
    <ind:filepath>/etc/group</ind:filepath>
    <ind:pattern operation="pattern match">^{{{ dedicated_ssh_groupname }}}:[^:]*:([0-9]+):</ind:pattern>
    <ind:instance datatype="int" operation="equals">1</ind:instance>
  </ind:textfilecontent54_object>

  <local_variable id="var_{{{ rule_id }}}_dedicated_gid" datatype="int" version="1"
    comment="gid of the {{{ dedicated_ssh_groupname }}} group">
    <object_component item_field="subexpression" object_ref="object_{{{ rule_id }}}_dedicated_gid" />
  </local_variable>
{{%- endif %}}
</def-group>
