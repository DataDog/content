<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("AIDE sends its report to the system log", rule_title=rule_title) }}}
    <criteria>
      <criterion comment="a report_url line of {{{ aide_conf_path }}} names syslog"
        test_ref="test_{{{ rule_id }}}" />
    </criteria>
  </definition>

  <ind:textfilecontent54_test check="all" check_existence="at_least_one_exists"
    comment="a report_url line of {{{ aide_conf_path }}} names syslog"
    id="test_{{{ rule_id }}}" version="1">
    <ind:object object_ref="object_{{{ rule_id }}}" />
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="object_{{{ rule_id }}}" version="1">
    <ind:filepath>{{{ aide_conf_path }}}</ind:filepath>
    <ind:pattern operation="pattern match">^[ \t]*report_url[ \t]*=[ \t]*syslog:\S*</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>
</def-group>
