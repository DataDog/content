{{% if 'ubuntu' in product %}}
{{% set gdm_conf_path = "/etc/gdm3/custom.conf" %}}
{{% elif 'debian' in product %}}
{{% set gdm_conf_path = "/etc/gdm3/daemon.conf" %}}
{{% else %}}
{{% set gdm_conf_path = "/etc/gdm/custom.conf" %}}
{{% endif %}}
{{#- CIS RHEL 7 and Ubuntu 20.04 1.7.10 fail only an Enable=true line: GDM
    keeps XDMCP off when Enable is unset or custom.conf is absent. -#}}
{{%- set xdmcp_unset_passes = product in ["rhel7", "ubuntu2004"] -%}}
{{{- oval_check_ini_file(path=gdm_conf_path, section='xdmcp', parameter='Enable', value='false', missing_parameter_pass=xdmcp_unset_passes, application='gdm', multi_value=false, missing_config_file_fail=not xdmcp_unset_passes, rule_id=rule_id, rule_title=rule_title) }}}
