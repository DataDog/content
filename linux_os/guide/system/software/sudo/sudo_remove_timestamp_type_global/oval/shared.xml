<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("No Defaults entry in the sudo configuration enables timestamp_type=global", rule_title=rule_title) }}}
    <criteria operator="AND">
      <criterion comment="timestamp_type=global is not enabled in /etc/sudoers"
        test_ref="test_{{{ rule_id }}}_etc_sudoers" />
      <criterion comment="timestamp_type=global is not enabled in /etc/sudoers.d"
        test_ref="test_{{{ rule_id }}}_etc_sudoers_d" />
    </criteria>
  </definition>

  <ind:textfilecontent54_test check="all" check_existence="none_exist"
    comment="timestamp_type=global is not enabled in /etc/sudoers"
    id="test_{{{ rule_id }}}_etc_sudoers" version="1">
    <ind:object object_ref="object_{{{ rule_id }}}_etc_sudoers" />
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="object_{{{ rule_id }}}_etc_sudoers" version="1">
    <ind:filepath>/etc/sudoers</ind:filepath>
    <ind:pattern operation="pattern match">^[ \t]*Defaults\b[^#\n]*[\s,]timestamp_type[ \t]*=[ \t]*"?global\b</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>

  <ind:textfilecontent54_test check="all" check_existence="none_exist"
    comment="timestamp_type=global is not enabled in /etc/sudoers.d"
    id="test_{{{ rule_id }}}_etc_sudoers_d" version="1">
    <ind:object object_ref="object_{{{ rule_id }}}_etc_sudoers_d" />
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="object_{{{ rule_id }}}_etc_sudoers_d" version="1">
    <!-- sudo skips the files of /etc/sudoers.d whose names contain a "." or end in "~" -->
    <ind:path>/etc/sudoers.d</ind:path>
    <ind:filename operation="pattern match">^[^.]*[^.~]$</ind:filename>
    <ind:pattern operation="pattern match">^[ \t]*Defaults\b[^#\n]*[\s,]timestamp_type[ \t]*=[ \t]*"?global\b</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>
</def-group>
