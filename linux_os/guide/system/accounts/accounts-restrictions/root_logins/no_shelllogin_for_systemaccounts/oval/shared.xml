<def-group>
  <definition class="compliance" id="no_shelllogin_for_systemaccounts" version="2">
    {{{ oval_metadata("The root account is the only system account that should have
      a login shell.", rule_title=rule_title) }}}
{{#- The CIS RHEL 7 audit reads every account below UID_MIN, and useradd -r gives out SYS_UID_MAX first. #}}
{{#- The Amazon Linux 2 audit fails only the valid shells, those of /etc/shells but nologin and false. #}}
{{%- if product == "rhel7" %}}
    <criteria operator="OR">
      <criteria operator="AND">
        <extend_definition comment="the system is not Amazon Linux 2"
          definition_ref="installed_OS_is_amzn2" negate="true" />
        <criterion comment="Test shell defined for UID from &lt;0, UID_MIN -1&gt;"
          test_ref="test_shell_defined_default_uid_range" />
      </criteria>
      <criteria operator="AND">
        <extend_definition comment="the system is Amazon Linux 2"
          definition_ref="installed_OS_is_amzn2" />
        <criterion comment="no account below UID_MIN but root, halt, sync, shutdown and nfsnobody has a valid shell"
          test_ref="test_no_shelllogin_for_systemaccounts_valid_shell" />
      </criteria>
    </criteria>
{{%- else %}}
    <criteria operator="OR">
      <!-- If SYS_UID_MIN and SYS_UID_MAX is not defined in /etc/login.defs or drop-in files
           perform the check that any /etc/passwd entry with shell defined
           has UID outside the default <0, UID_MIN -1> range.
           If at least one UID with shell defined exists within that range,
           the requirement isn't met -->
      <criteria operator="AND">
        {{% if product in [ 'slmicro6', 'sle15', 'sle16' ] %}}
        <criteria operator="AND">
          <criterion comment="Test SYS_UID_MIN not defined in {{{ login_defs_path }}}"
        test_ref="test_sys_uid_min_not_defined" />
          <criterion comment="Test SYS_UID_MAX not defined in {{{ login_defs_path }}}"
        test_ref="test_sys_uid_max_not_defined" />
          <criterion comment="Test SYS_UID_MIN not defined in drop-in files"
        test_ref="test_sys_uid_min_not_defined_drop_in" />
          <criterion comment="Test SYS_UID_MAX not defined in drop-in files"
        test_ref="test_sys_uid_max_not_defined_drop_in" />
        </criteria>
        {{% else %}}
        <criterion comment="Test SYS_UID_MIN not defined in {{{ login_defs_path }}}"
        test_ref="test_sys_uid_min_not_defined" />
        <criterion comment="Test SYS_UID_MAX not defined in {{{ login_defs_path }}}"
        test_ref="test_sys_uid_max_not_defined" />
        {{% endif %}}
        <criterion comment="Test shell defined for UID from &lt;0, UID_MIN -1&gt;"
        test_ref="test_shell_defined_default_uid_range" />
      </criteria>
      {{% if product in [ 'slmicro6', 'sle15', 'sle16' ] %}}
      <criteria operator="OR">
        <criteria operator="AND">
            <criterion comment="Test SYS_UID_MIN defined in drop-in files" test_ref="test_sys_uid_min_not_defined_drop_in" negate="true" />
            <criterion comment="Test SYS_UID_MAX defined in drop-in files" test_ref="test_sys_uid_max_not_defined_drop_in" negate="true" />
            <criterion comment="Test shell defined for reserved system UIDs against drop in" test_ref="test_shell_defined_reserved_uid_range_drop_in" />
            <criterion comment="Test shell defined for dynamically allocated system UIDs against drop in" test_ref="test_shell_defined_dynalloc_uid_range_drop_in" />
        </criteria>
        <criteria operator="AND">
          <criterion comment="Test SYS_UID_MIN not defined in drop-in files" test_ref="test_sys_uid_min_not_defined_drop_in" />
          <criterion comment="Test SYS_UID_MAX not defined in drop-in files" test_ref="test_sys_uid_max_not_defined_drop_in" />
          <criterion comment="Test SYS_UID_MIN defined in {{{ login_defs_path }}}" test_ref="test_sys_uid_min_not_defined" negate="true" />
          <criterion comment="Test SYS_UID_MAX defined in {{{ login_defs_path }}}" test_ref="test_sys_uid_max_not_defined" negate="true" />
          <criterion comment="Test shell defined for reserved system UIDs" test_ref="test_shell_defined_reserved_uid_range" />
          <criterion comment="Test shell defined for dynamically allocated system UIDs" test_ref="test_shell_defined_dynalloc_uid_range" />
        </criteria>
      </criteria>
      {{% else %}}
      <!-- If both SYS_UID_MIN and SYS_UID_MAX are defined in /etc/login.defs or drop-in files
           perform both checks:
          <criterion comment="Test SYS_UID_MAX not defined in {{{ login_defs_path }}} and drop-in files"
        test_ref="test_sys_uid_max_not_defined" />
           * That any /etc/passwd entry with shell defined has UID outside
           the range for reserved system accounts <0, SYS_UID_MIN> range,
           * That any /etc/passwd entries with shell defined has UID outside
           the range for dynamically allocated system accounts <SYS_UID_MIN, SYS_UID_MAX>
           If at least one UID with shell defined exists within some of the two
           ranges, the requirement isn't met -->
      <criteria operator="AND">
        <criterion comment="Test SYS_UID_MIN defined in {{{ login_defs_path }}}"
        test_ref="test_sys_uid_min_not_defined" negate="true" />
        <criterion comment="Test SYS_UID_MAX defined in {{{ login_defs_path }}}"
        test_ref="test_sys_uid_max_not_defined" negate="true" />
        <criterion comment="Test shell defined for reserved system UIDs"
        test_ref="test_shell_defined_reserved_uid_range" />
        <criterion comment="Test shell defined for dynamically allocated system UIDs"
        test_ref="test_shell_defined_dynalloc_uid_range" />
      </criteria>
      {{% endif %}}
    </criteria>
{{%- endif %}}
  </definition>

  <!-- First define OVAL entities used by both criteria above -->

  <!-- Get last occurrence of UID_MIN from /etc/login.defs as OVAL object -->
  <ind:textfilecontent54_object id="object_last_uid_min_from_etc_login_defs"
  version="1">
    <ind:behaviors singleline="true" />
    <ind:filepath>{{{ login_defs_path }}}</ind:filepath>
    <!-- Last (uncommented) instance od UID_MIN directive -->
    <ind:pattern operation="pattern match">.*(?:^|\n)\s*(UID_MIN[\s]+[\d]+)\s*(?:$|\n)</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>

  <!-- Get last occurrence of SYS_UID_MIN from /etc/login.defs as OVAL object -->
  <ind:textfilecontent54_object id="object_last_sys_uid_min_from_etc_login_defs"
  version="1">
    <ind:behaviors singleline="true" />
    <ind:filepath>{{{ login_defs_path }}}</ind:filepath>
    <!-- Last (uncommented) instance of SYS_UID_MIN directive -->
    <ind:pattern operation="pattern match">.*(?:^|\n)\s*(SYS_UID_MIN[\s]+[\d]+)\s*(?:$|\n)</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>

  <!-- Get last occurrence of SYS_UID_MAX from /etc/login.defs as OVAL object -->
  <ind:textfilecontent54_object id="object_last_sys_uid_max_from_etc_login_defs" version="1">
    <ind:behaviors singleline="true" />
    <ind:filepath>{{{ login_defs_path }}}</ind:filepath>
    <!-- Last (uncommented) instance of SYS_UID_MAX directive -->
    <ind:pattern operation="pattern match">.*(?:^|\n)\s*(SYS_UID_MAX[\s]+[\d]+)\s*(?:$|\n)</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>

  {{% if product in [ 'slmicro6', 'sle15', 'sle16' ] %}}
  {{% set login_defs_drop_in_config_dir = "/".join(login_defs_drop_in_path.split("/")[:-1]) %}}

  <!-- Get last occurrence of SYS_UID_MIN from drop-in files as OVAL object -->
  <ind:textfilecontent54_object id="object_last_sys_uid_min_from_drop_in_defs"
  version="1">
    <ind:behaviors singleline="true" />
    <ind:path>{{{ login_defs_drop_in_config_dir }}}</ind:path>
    <ind:filename operation="pattern match">.*\.defs$</ind:filename>
    <!-- Last (uncommented) instance of SYS_UID_MIN directive -->
    <ind:pattern operation="pattern match">.*(?:^|\n)\s*(SYS_UID_MIN[\s]+[\d]+)\s*(?:$|\n)</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>

  <!-- Get last occurrence of SYS_UID_MAX from drop-in files as OVAL object -->
  <ind:textfilecontent54_object id="object_last_sys_uid_max_from_drop_in_defs" version="1">
    <ind:behaviors singleline="true" />
    <ind:path>{{{ login_defs_drop_in_config_dir }}}</ind:path>
    <ind:filename operation="pattern match">.*\.defs$</ind:filename>
    <!-- Last (uncommented) instance of SYS_UID_MAX directive -->
    <ind:pattern operation="pattern match">.*(?:^|\n)\s*(SYS_UID_MAX[\s]+[\d]+)\s*(?:$|\n)</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>
  {{% endif %}}

  <!-- Get all /etc/passwd entries having shell defined as OVAL object -->
  <ind:textfilecontent54_object id="object_etc_passwd_entries" version="1">
    <ind:filepath>/etc/passwd</ind:filepath>
{{% if "ubuntu" in product or "sle" in product or "slmicro" in product %}}
    <ind:pattern operation="pattern match">^(?!root).*:x:([\d]+):[\d]+:[^:]*:[^:]*:(?!\/usr\/sbin\/nologin|\/sbin\/nologin|\/bin\/sync|\/sbin\/shutdown|\/sbin\/halt|\/bin\/false|\/usr\/bin\/false).*$</ind:pattern>
{{% else %}}
    <ind:pattern operation="pattern match">^(?!root).*:x:([\d]+):[\d]+:[^:]*:[^:]*:(?!\/usr\/sbin\/nologin|\/sbin\/nologin|\/bin\/sync|\/sbin\/shutdown|\/sbin\/halt).*$</ind:pattern>
{{% endif %}}
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>

  <!-- FIRST CRITERION -->
  <!-- If both SYS_UID_MIN and SYS_UID_MAX aren't defined in /etc/login.defs or drop-in files
       perform the check that any /etc/passwd entry with shell defined has
       UID outside the <0, UID_MIN - 1> range -->

  <!-- Actual /etc/login.defs UID_MIN value as OVAL variable -->
  <local_variable id="variable_uid_min_value" datatype="int"
  comment="Value of last UID_MIN from {{{ login_defs_path }}} and drop-in files" version="1">
    <regex_capture pattern="UID_MIN[\s]+(\d+)">
      <object_component item_field="subexpression"
      object_ref="object_last_uid_min_from_etc_login_defs" />
    </regex_capture>
  </local_variable>

  <!-- Perform the default <0, UID_MIN - 1> UID range test itself -->
  <!-- Thus check that any /etc/passwd entry with shell defined
       has UID outside of <0, UID_MIN -1> range -->
  <ind:textfilecontent54_test state_operator="OR" id="test_shell_defined_default_uid_range" check="all"
  check_existence="any_exist" comment="&lt;0, UID_MIN - 1&gt; system UIDs having shell set"
  version="1">
    <ind:object object_ref="object_etc_passwd_entries" />
    <ind:state state_ref="state_uid_less_than_zero" />
    <ind:state state_ref="state_uid_greater_than_or_equal_uid_min" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_state id="state_uid_less_than_zero" version="1">
    <ind:subexpression datatype="int" operation="less than">0</ind:subexpression>
  </ind:textfilecontent54_state>
  <ind:textfilecontent54_state id="state_uid_greater_than_or_equal_uid_min" version="1">
    {{% if product in [ 'slmicro6', 'sle15', 'sle16' ] %}}
    <ind:subexpression datatype="int" operation="greater than or equal">{{{ uid_min }}}</ind:subexpression>
    {{% else %}}
    <ind:subexpression datatype="int" operation="greater than or equal" var_ref="variable_uid_min_value" />
    {{% endif %}}
  </ind:textfilecontent54_state>

{{%- if product == "rhel7" %}}
  <ind:textfilecontent54_object id="obj_no_shelllogin_for_systemaccounts_valid_shells" version="1">
    <ind:filepath>/etc/shells</ind:filepath>
    <ind:pattern operation="pattern match">^(/.*)$</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
    <filter action="exclude">state_no_shelllogin_for_systemaccounts_nologin_false</filter>
  </ind:textfilecontent54_object>

  <ind:textfilecontent54_state id="state_no_shelllogin_for_systemaccounts_nologin_false" version="1">
    <ind:subexpression operation="pattern match">/(?:nologin|false)$</ind:subexpression>
  </ind:textfilecontent54_state>

  <local_variable id="var_no_shelllogin_for_systemaccounts_valid_shells" datatype="string" version="1"
    comment="valid login shells">
    <object_component item_field="subexpression" object_ref="obj_no_shelllogin_for_systemaccounts_valid_shells" />
  </local_variable>

  <unix:password_object id="obj_no_shelllogin_for_systemaccounts_valid_shell" version="1">
    <unix:username operation="pattern match">.*</unix:username>
    <filter action="exclude">state_no_shelllogin_for_systemaccounts_ignored</filter>
    <filter action="include">state_no_shelllogin_for_systemaccounts_below_uid_min</filter>
    <filter action="include">state_no_shelllogin_for_systemaccounts_valid_shell</filter>
  </unix:password_object>

  <unix:password_state id="state_no_shelllogin_for_systemaccounts_ignored" version="1">
    <unix:username operation="pattern match">^(?:root|halt|sync|shutdown|nfsnobody)$</unix:username>
  </unix:password_state>

  <unix:password_state id="state_no_shelllogin_for_systemaccounts_below_uid_min" version="1">
    <unix:user_id datatype="int" operation="less than" var_ref="variable_uid_min_value" />
  </unix:password_state>

  <unix:password_state id="state_no_shelllogin_for_systemaccounts_valid_shell" version="1">
    <unix:login_shell var_ref="var_no_shelllogin_for_systemaccounts_valid_shells" var_check="at least one" />
  </unix:password_state>

  <unix:password_test id="test_no_shelllogin_for_systemaccounts_valid_shell" version="1"
    check="all" check_existence="none_exist"
    comment="accounts below UID_MIN but root, halt, sync, shutdown and nfsnobody with a valid shell">
    <unix:object object_ref="obj_no_shelllogin_for_systemaccounts_valid_shell" />
  </unix:password_test>
{{%- endif %}}

  <!-- Test if SYS_UID_MIN not defined in /etc/login.defs -->
  <ind:textfilecontent54_test id="test_sys_uid_min_not_defined"
  comment="SYS_UID_MIN not defined in {{{ login_defs_path }}}" check="all"
  check_existence="none_exist" version="1">
    <ind:object object_ref="object_last_sys_uid_min_from_etc_login_defs" />
  </ind:textfilecontent54_test>

  <!-- Test if SYS_UID_MAX not defined in /etc/login.defs -->
  <ind:textfilecontent54_test id="test_sys_uid_max_not_defined"
  comment="SYS_UID_MAX not defined in {{{ login_defs_path }}}" check="all"
  check_existence="none_exist" version="1">
    <ind:object object_ref="object_last_sys_uid_max_from_etc_login_defs" />
  </ind:textfilecontent54_test>

  {{% if product in [ 'slmicro6', 'sle15', 'sle16' ] %}}
  <!-- Test if SYS_UID_MIN not defined in drop-in files -->
  <ind:textfilecontent54_test id="test_sys_uid_min_not_defined_drop_in"
  comment="SYS_UID_MIN not defined in drop-in files" check="all"
  check_existence="none_exist" version="1">
    <ind:object object_ref="object_last_sys_uid_min_from_drop_in_defs" />
  </ind:textfilecontent54_test>

  <!-- Test if SYS_UID_MAX not defined in drop-in files -->
  <ind:textfilecontent54_test id="test_sys_uid_max_not_defined_drop_in"
  comment="SYS_UID_MAX not defined in drop-in files" check="all"
  check_existence="none_exist" version="1">
    <ind:object object_ref="object_last_sys_uid_max_from_drop_in_defs" />
  </ind:textfilecontent54_test>
  {{% endif %}}

  <!-- SECOND CRITERION -->
  <!-- If both SYS_UID_MIN and SYS_UID_MAX are defined in /etc/login.defs or drop-in files,
       perform more advanced test:
       * Check that any /etc/passwd entry with shell defined has UID
       outside the range of reserved system UIDs, thus <0, SYS_UID_MIN>,
       * Also check that any /etc/passwd entry with shell defined has
       UID outside the range of dynamically allocated system UIDs, thus
       <SYS_UID_MIN, SYS_UID_MAX>
  -->

  <!-- Actual SYS_UID_MIN value as OVAL variable (prioritize main file) -->
  <local_variable id="variable_sys_uid_min_value" datatype="int"
  comment="Value of last SYS_UID_MIN from {{{ login_defs_path }}} and drop-in files" version="1">
    <regex_capture pattern="SYS_UID_MIN[\s]+(\d+)">
      <object_component item_field="subexpression"
      object_ref="object_last_sys_uid_min_from_etc_login_defs" />
    </regex_capture>
  </local_variable>

  <!-- Actual SYS_UID_MAX value as OVAL variable (prioritize main file) -->
  <local_variable id="variable_sys_uid_max_value" datatype="int"
  comment="Value of last SYS_UID_MAX from {{{ login_defs_path }}} and drop-in files" version="1">
    <regex_capture pattern="SYS_UID_MAX[\s]+(\d+)">
      <object_component item_field="subexpression"
      object_ref="object_last_sys_uid_max_from_etc_login_defs" />
    </regex_capture>
  </local_variable>

  <!-- Actual SYS_UID_MIN value as OVAL variable from drop in file -->
  <local_variable id="variable_sys_uid_min_value_drop_in" datatype="int"
  comment="Value of last SYS_UID_MIN from drop-in files" version="1">
    <regex_capture pattern="SYS_UID_MIN[\s]+(\d+)">
      <object_component item_field="subexpression" object_ref="object_last_sys_uid_min_from_drop_in_defs" />
    </regex_capture>
  </local_variable>

  <!-- Actual SYS_UID_MAX value as OVAL variable (prioritize main file) -->
  <local_variable id="variable_sys_uid_max_value_drop_in" datatype="int"
  comment="Value of last SYS_UID_MAX from drop-in files" version="1">
    <regex_capture pattern="SYS_UID_MAX[\s]+(\d+)">
      <object_component item_field="subexpression" object_ref="object_last_sys_uid_max_from_drop_in_defs" />
    </regex_capture>
  </local_variable>

  <!-- Perform the reserved UID range <0, SYS_UID_MIN> test itself -->
  <!-- Thus check that any /etc/passwd entry with shell defined
       has UID outside of <0, SYS_UID_MIN> range -->
  <ind:textfilecontent54_test state_operator="OR" id="test_shell_defined_reserved_uid_range" check="all"
  check_existence="any_exist" comment="&lt;0, SYS_UID_MIN&gt; system UIDs having shell set"
  version="1">
    <ind:object object_ref="object_etc_passwd_entries" />
    <ind:state state_ref="state_uid_less_than_zero" />
    <ind:state state_ref="state_uid_greater_than_or_equal_sys_uid_min" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_state id="state_uid_greater_than_or_equal_sys_uid_min" version="1">
    <ind:subexpression datatype="int" operation="greater than or equal" var_ref="variable_sys_uid_min_value" />
  </ind:textfilecontent54_state>

  <!-- Perform the dynamically allocated UID range <SYS_UID_MIN, SYS_UID_MAX> test itself -->
  <!-- Thus check that any /etc/passwd entry with shell defined
       has UID outside of <SYS_UID_MIN, SYS_UID_MAX> range -->
  <ind:textfilecontent54_test state_operator="OR" id="test_shell_defined_dynalloc_uid_range" check="all"
  check_existence="any_exist" comment="&lt;SYS_UID_MIN, SYS_UID_MAX&gt; system UIDS having shell set"
  version="1">
    <ind:object object_ref="object_etc_passwd_entries" />
    <ind:state state_ref="state_uid_less_than_sys_uid_min" />
    <ind:state state_ref="state_uid_greater_than_or_equal_sys_uid_max" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_state id="state_uid_less_than_sys_uid_min" version="1">
    <ind:subexpression datatype="int" operation="less than" var_ref="variable_sys_uid_min_value" />
  </ind:textfilecontent54_state>
  <ind:textfilecontent54_state id="state_uid_greater_than_or_equal_sys_uid_max" version="1">
    <ind:subexpression datatype="int" operation="greater than or equal" var_ref="variable_sys_uid_max_value" />
  </ind:textfilecontent54_state>

  <!-- Perform the reserved UID range <0, SYS_UID_MIN> test itself -->
  <!-- Thus check that any /etc/passwd entry with shell defined
       has UID outside of <0, SYS_UID_MIN> range -->
  <ind:textfilecontent54_test state_operator="OR" id="test_shell_defined_reserved_uid_range_drop_in" check="all"
  check_existence="any_exist" comment="&lt;0, SYS_UID_MIN&gt; system UIDs having shell set"
  version="1">
    <ind:object object_ref="object_etc_passwd_entries" />
    <ind:state state_ref="state_uid_less_than_zero" />
    <ind:state state_ref="state_uid_greater_than_or_equal_sys_uid_min_drop_in" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_state id="state_uid_greater_than_or_equal_sys_uid_min_drop_in" version="1">
    <ind:subexpression datatype="int" operation="greater than or equal" var_ref="variable_sys_uid_min_value_drop_in" />
  </ind:textfilecontent54_state>

  <!-- Perform the dynamically allocated UID range <SYS_UID_MIN, SYS_UID_MAX> test itself -->
  <!-- Thus check that any /etc/passwd entry with shell defined
       has UID outside of <SYS_UID_MIN, SYS_UID_MAX> range -->
  <ind:textfilecontent54_test state_operator="OR" id="test_shell_defined_dynalloc_uid_range_drop_in" check="all"
  check_existence="any_exist" comment="&lt;SYS_UID_MIN, SYS_UID_MAX&gt; system UIDS having shell set"
  version="1">
    <ind:object object_ref="object_etc_passwd_entries" />
    <ind:state state_ref="state_uid_less_than_sys_uid_min_drop_in" />
    <ind:state state_ref="state_uid_greater_than_or_equal_sys_uid_max_drop_in" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_state id="state_uid_less_than_sys_uid_min_drop_in" version="1">
    <ind:subexpression datatype="int" operation="less than" var_ref="variable_sys_uid_min_value_drop_in" />
  </ind:textfilecontent54_state>
  <ind:textfilecontent54_state id="state_uid_greater_than_or_equal_sys_uid_max_drop_in" version="1">
    <ind:subexpression datatype="int" operation="greater than or equal" var_ref="variable_sys_uid_max_value_drop_in" />
  </ind:textfilecontent54_state>

</def-group>
