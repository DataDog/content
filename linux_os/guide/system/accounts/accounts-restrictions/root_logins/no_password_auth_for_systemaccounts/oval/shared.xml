<def-group>
    <definition class="compliance" id="{{{ rule_id }}}" version="1">
        {{{ oval_metadata("Ensure that System Accounts Are Locked", rule_title=rule_title) }}}
{{#- The CIS RHEL 7 audit also requires every account with the nologin shell to be locked. #}}
{{%- if product == "rhel7" %}}
        <criteria operator="AND">
            <criterion test_ref="test_{{{ rule_id }}}"
                comment="system accounts must not have a password defined"/>
            <criterion test_ref="test_{{{ rule_id }}}_nologin"
                comment="accounts with the nologin shell must not have a password defined"/>
        </criteria>
{{%- else %}}
        <criteria >
            <criterion test_ref="test_{{{ rule_id }}}"
                comment="system accounts must not have a password defined"/>
        </criteria>
{{%- endif %}}
    </definition>

    {{%- set system_accounts_object = "object_" ~ rule_id ~ "_objects" -%}}
    {{{ create_system_accounts_list_object(system_accounts_object, rule_id=rule_id) }}}

    <local_variable id="var_{{{ rule_id }}}_usernames" datatype="string" version="1"
        comment="Variable including usernames of system accounts">
        <object_component item_field="username" object_ref="{{{ system_accounts_object }}}"/>
    </local_variable>

    <unix:shadow_object id="object_{{{ rule_id }}}" version="1">
        <unix:username var_ref="var_{{{ rule_id }}}_usernames" var_check="at least one"/>
        <filter action="exclude">filter_{{{ rule_id }}}_no_passwords_or_locked_accounts</filter>
    </unix:shadow_object>

    <unix:shadow_state id="filter_{{{ rule_id }}}_no_passwords_or_locked_accounts" version="1">
        <unix:password operation="pattern match">^(!|!!|!\*|\*|!locked).*$</unix:password>
    </unix:shadow_state>

    <unix:shadow_test id="test_{{{ rule_id }}}" version="1"
        check="all" check_existence="none_exist"
        comment="system accounts with a password defined">
        <unix:object object_ref="object_{{{ rule_id }}}"/>
    </unix:shadow_test>
{{%- if product == "rhel7" %}}

    <unix:password_object id="object_{{{ rule_id }}}_nologin_accounts" version="1">
        <unix:username datatype="string" operation="pattern match">.*</unix:username>
        <filter action="include">state_{{{ rule_id }}}_nologin_shell</filter>
    </unix:password_object>

    <unix:password_state id="state_{{{ rule_id }}}_nologin_shell" version="1">
        <unix:login_shell datatype="string" operation="pattern match">nologin</unix:login_shell>
    </unix:password_state>

    <local_variable id="var_{{{ rule_id }}}_nologin_usernames" datatype="string" version="1"
        comment="Variable including usernames of accounts with the nologin shell">
        <object_component item_field="username" object_ref="object_{{{ rule_id }}}_nologin_accounts"/>
    </local_variable>

    <unix:shadow_object id="object_{{{ rule_id }}}_nologin" version="1">
        <unix:username var_ref="var_{{{ rule_id }}}_nologin_usernames" var_check="at least one"/>
        <filter action="exclude">filter_{{{ rule_id }}}_no_passwords_or_locked_accounts</filter>
    </unix:shadow_object>

    <unix:shadow_test id="test_{{{ rule_id }}}_nologin" version="1"
        check="all" check_existence="none_exist"
        comment="accounts with the nologin shell and a password defined">
        <unix:object object_ref="object_{{{ rule_id }}}_nologin"/>
    </unix:shadow_test>
{{%- endif %}}
</def-group>
