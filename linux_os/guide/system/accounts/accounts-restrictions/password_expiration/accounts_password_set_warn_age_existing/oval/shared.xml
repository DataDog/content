{{# The regular expression filters away accounts with no passwords and locked passwords (passwords are located in the 2nd field of /etc/shadow entries). #}}
{{#- The CIS RHEL 7 audit fails a user with a password whose warning field is empty or -1, which gives no warning. #}}
{{%- set regex_empty = "^(?:[^:]*:)(?:\\$[^:]*:)(?:[^:]*:){3}(?:\\s*|-\\d+):(?:[^:]*:){2}(?:[^:]*)$" if product == "rhel7" else none %}}
{{{ test_etc_shadow_password_variable(
    regex="^(?:[^:]*:)(?:[^\!\*:]*:)(?:[^:]*:){3}(\d+):(?:[^:]*:){2}(?:[^:]*)$",
    external_variable_id="var_accounts_password_warn_age_login_defs",
    operation="greater than or equal",
    description="Set Existing Passwords Warning Age", rule_id=rule_id, rule_title=rule_title, regex_empty=regex_empty) }}}
