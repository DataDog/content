{{#-
  The CIS Benchmarks audit TMOUT in three ways, followed here per product.
  Amazon Linux 2023 v1.0.0 4.6.3 and RHEL 7 v4.0.0 4.5.3.2: one file of
  /etc/bashrc, /etc/profile and /etc/profile.d/*.sh assigns TMOUT a positive
  value and has a readonly and an export command for it, and no file of the
  set assigns 0 or a value above the limit. RHEL 9 and AlmaLinux 9 v3.0.0
  5.4.3.2: every file that assigns TMOUT marks it readonly and exports it in
  the same file, with typeset -xr or with readonly and export. The other
  benchmarks (RHEL 8 v4.0.0, RHEL 10 v1.0.1, Ubuntu 22.04 v3.0.0, Ubuntu 24.04
  v2.0.0 5.4.3.2) require the same of every file that mentions TMOUT. Every
  value assigned has to be in range, where the RHEL 9 and AlmaLinux 9 audits
  read the last one of each file. The regular expressions are those of the
  audits, confined to one line, since a pattern applies to a whole file here.
-#}}
<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("The interactive shell timeout TMOUT is configured as the CIS Benchmark requires", rule_title=rule_title) }}}
    <criteria operator="AND">
{{% if product in ["al2023", "rhel7"] %}}
      <criterion comment="a file assigns TMOUT and marks it readonly and exported"
        test_ref="test_accounts_tmout_cis_configured" />
{{% elif product in ["rhel9", "almalinux9"] %}}
      <criterion comment="every file that assigns TMOUT marks it readonly and exported"
        test_ref="test_accounts_tmout_cis_per_file" />
{{% else %}}
      <criterion comment="every file that mentions TMOUT assigns it and marks it readonly and exported"
        test_ref="test_accounts_tmout_cis_per_file" />
{{% endif %}}
      <criterion comment="every TMOUT value is at most var_accounts_tmout"
        test_ref="test_accounts_tmout_cis_upper_bound" />
      <criterion comment="every TMOUT value is at least 1"
        test_ref="test_accounts_tmout_cis_lower_bound" />
    </criteria>
  </definition>

{{% if product in ["al2023", "rhel7"] %}}
  <ind:textfilecontent54_test check="all" check_existence="at_least_one_exists" version="1"
    comment="a file assigns TMOUT and has readonly and export commands for it"
    id="test_accounts_tmout_cis_configured">
    <ind:object object_ref="obj_accounts_tmout_cis_configured" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_object id="obj_accounts_tmout_cis_configured" version="1"
    comment="files that assign TMOUT a positive value and have readonly and export commands for it">
    <ind:filepath operation="pattern match">^/etc/(?:bashrc|profile|profile\.d/[^/.][^/]*\.sh)$</ind:filepath>
    <ind:pattern operation="pattern match">\A(?=[\s\S]*?^([^\S\n]*(?:[^#\n]+[^\S\n]+)?TMOUT=[1-9]\d*\b.*))(?=[\s\S]*?^[^\S\n]*(?:[^#\n]+;[^\S\n]*)?readonly[^\S\n]+TMOUT(?:[^\S\n]+|[^\S\n]*;|[^\S\n]*$|=[1-9]\d*)\b)(?=[\s\S]*?^[^\S\n]*(?:[^#\n]+;[^\S\n]*)?export[^\S\n]+TMOUT(?:[^\S\n]+|[^\S\n]*;|[^\S\n]*$|=[1-9]\d*)\b)</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>

  <ind:textfilecontent54_object id="obj_accounts_tmout_cis_values" version="1"
    comment="TMOUT values assigned in /etc/bashrc, /etc/profile and /etc/profile.d/*.sh">
    <ind:filepath operation="pattern match">^/etc/(?:bashrc|profile|profile\.d/[^/.][^/]*\.sh)$</ind:filepath>
    <ind:pattern operation="pattern match">(?:^|\G)[^#\n]*?(?&lt;!\S)TMOUT=(0+|[1-9]\d*)\b</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>
{{% else %}}
{{% if product in ["rhel9", "almalinux9"] %}}
{{% set tmout_files = "^/(?:etc/(?:(?:[^/.][^/]*)?bashrc|profile|profile\.d/(?:[^/.][^/]*\.sh|sh\.local))|usr/etc/profile\.d/(?:[^/.][^/]*\.sh|sh\.local))$" %}}
{{% else %}}
{{% set tmout_files = "^/etc/(?:(?:[^/.][^/]*)?bashrc|profile|profile\.d/[^/.][^/]*\.sh)$" %}}
{{% endif %}}
  <ind:textfilecontent54_test check="all" check_existence="none_exist" version="1"
    comment="each file meets the TMOUT requirement for single files"
    id="test_accounts_tmout_cis_per_file">
    <ind:object object_ref="obj_accounts_tmout_cis_per_file" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_object id="obj_accounts_tmout_cis_per_file" version="1"
    comment="files that set or mention TMOUT without the value, readonly and export it needs">
    <ind:filepath operation="pattern match">{{{ tmout_files }}}</ind:filepath>
{{% if product in ["rhel9", "almalinux9"] %}}
    <ind:pattern operation="pattern match">\A(?=[\s\S]*?^([^#\n\r]*?\bTMOUT=\d+\b.*))(?:(?![\s\S]*?^\h*(?:typeset\h-xr\hTMOUT=\d+|[^#\n\r]*?\breadonly\h+TMOUT\b))|(?![\s\S]*?^\h*(?:typeset\h-xr\hTMOUT=\d+|[^#\n\r]*?\bexport\b(?:[^#\n\r]+\b)?TMOUT\b)))</ind:pattern>
{{% else %}}
    <ind:pattern operation="pattern match">\A(?=[\s\S]*?^([^#\n\r]*?\bTMOUT\b.*))(?:(?![\s\S]*?^[^#\n\r]*?\bTMOUT=\d+\b)|(?![\s\S]*?^\h*(?:typeset\h-xr\hTMOUT=\d+|[^#\n\r]*?\breadonly\h+TMOUT\b))|(?![\s\S]*?^\h*(?:typeset\h-xr\hTMOUT=\d+|[^#\n\r]*?\bexport\b(?:[^#\n\r]+\b)?TMOUT\b)))</ind:pattern>
{{% endif %}}
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>

  <ind:textfilecontent54_object id="obj_accounts_tmout_cis_values" version="1"
    comment="TMOUT values assigned in the shell initialization files">
    <ind:filepath operation="pattern match">{{{ tmout_files }}}</ind:filepath>
    <ind:pattern operation="pattern match">(?:^|\G)[^#\n\r]*?\bTMOUT=(\d+)\b</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>
{{% endif %}}

  <ind:textfilecontent54_test check="all" version="1"
    check_existence="{{{ "any_exist" if product in ["al2023", "rhel7"] else "at_least_one_exists" }}}"
    comment="every TMOUT value is at most var_accounts_tmout"
    id="test_accounts_tmout_cis_upper_bound">
    <ind:object object_ref="obj_accounts_tmout_cis_values" />
    <ind:state state_ref="state_accounts_tmout_cis_upper_bound" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_test check="all" version="1"
    check_existence="{{{ "any_exist" if product in ["al2023", "rhel7"] else "at_least_one_exists" }}}"
    comment="every TMOUT value is at least 1"
    id="test_accounts_tmout_cis_lower_bound">
    <ind:object object_ref="obj_accounts_tmout_cis_values" />
    <ind:state state_ref="state_accounts_tmout_cis_lower_bound" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_state id="state_accounts_tmout_cis_upper_bound" version="1">
    <ind:subexpression datatype="int" operation="less than or equal" var_check="all"
      var_ref="var_accounts_tmout" />
  </ind:textfilecontent54_state>

  <ind:textfilecontent54_state id="state_accounts_tmout_cis_lower_bound" version="1">
    <ind:subexpression datatype="int" operation="greater than or equal">1</ind:subexpression>
  </ind:textfilecontent54_state>

  <external_variable comment="maximum TMOUT in seconds" datatype="int"
    id="var_accounts_tmout" version="1" />
</def-group>
