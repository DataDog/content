documentation_complete: true

title: 'pwquality Defaults Count as Compliant'

description: |-
    Whether a pwquality option that the configuration files leave out counts as
    compliant when its default value meets the requirement. The CIS Benchmarks
    accept the defaults of dictcheck and enforcing.

type: boolean

operator: equals

interactive: false

options:
    default: false
    false: false
    true: true
