{{%- set rx_a0_tail = "[\s]+(-S[\s]+clock_settime[\s]+|([\s]+|[,])clock_settime([\s]+|[,]))-F[\s]+a0=(?:0x)?0[\s]+(?:-F[\s]+key=|-k[\s]+)[\S]+[\s]*$" -%}}
{{#- CIS RHEL 7 v4.0.0 5.2.3.4 audits clock_settime with the other time syscalls, without an argument filter -#}}
{{%- set rx_tail = "[\s]+(?:-S[\s]+\S+[\s]+)*?-S[\s]+(?:\S+,)?clock_settime(?:,\S+)?[\s]+(?:-S[\s]+\S+[\s]+)*(?:-F[\s]+key=|-k[\s]+)[\S]+[\s]*$" if product == "rhel7" else rx_a0_tail -%}}
{{%- set rx_b32 = "^[\s]*-a[\s]+always,exit[\s]+-F[\s]+arch=b32" + rx_tail -%}}
{{%- set rx_b64 = "^[\s]*-a[\s]+always,exit[\s]+-F[\s]+arch=b64" + rx_tail -%}}
